        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Dialogue 2">
          <stringProp name="HTTPSampler.domain">${my_host}</stringProp>
          <stringProp name="HTTPSampler.port">${my_port}</stringProp>
